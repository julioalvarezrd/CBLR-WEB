generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StationType {
  HEADQUARTERS
  SUBSTATION
}

enum PersonnelType {
  VOLUNTEER
  FIXED
}

enum PersonnelStatus {
  ACTIVE
  INACTIVE
}

enum DocumentType {
  CEDULA
  PASSPORT
}

enum Sex {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DOMESTIC_PARTNERSHIP
  DIVORCED
  WIDOWED
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum EducationLevel {
  BASIC
  SECONDARY
  TECHNICAL
  UNIVERSITY
  POSTGRADUATE
  OTHER
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  roles                 UserRole[]       @relation("UserRoles")
  roleAssignments       UserRole[]       @relation("UserRoleAssignedBy")
  permissionAssignments RolePermission[] @relation("RolePermissionAssignedBy")
  auditLogs             AuditLog[]       @relation("AuditActor")
  personnelCreated      PersonnelMember[] @relation("PersonnelMemberCreatedBy")
}

model Role {
  id             String   @id @default(cuid())
  name           String
  nameNormalized String   @unique
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  key         String   @id
  module      String
  action      String
  label       String
  description String?
  critical    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
}

model RolePermission {
  roleId        String
  permissionKey String
  assignedAt    DateTime @default(now())
  assignedById  String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)
  assignedBy User?      @relation("RolePermissionAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@index([assignedById])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Station {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      StationType
  address   String?
  phone     String?
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([isActive, sortOrder])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent              Department?               @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            Department[]              @relation("DepartmentHierarchy")
  positions           Position[]
  personnelMembers    PersonnelMember[]
  personnelAssignments PersonnelAssignmentHistory[]

  @@unique([name, parentId])
  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Position {
  id           String   @id @default(cuid())
  name         String
  departmentId String?
  description  String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department           Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  personnelMembers     PersonnelMember[]
  personnelAssignments PersonnelAssignmentHistory[]

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([isActive, sortOrder])
}

model Rank {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  hierarchy Int      @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnelMembers PersonnelMember[]
  personnelHistory PersonnelRankHistory[]

  @@index([isActive, hierarchy])
}

model OperationalCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  category    String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isActive, sortOrder])
}

model InstitutionalSettings {
  id                  Int      @id @default(1)
  organizationName    String
  shortName           String
  institutionalPrefix String?
  rnc                 String?
  phone               String?
  email               String?
  website             String?
  address             String?
  municipality        String?
  province            String?
  country             String?
  timezone            String?
  documentHeaderText  String?
  documentFooterText  String?
  logoData            Bytes?
  logoMimeType        String?
  updatedAt           DateTime @updatedAt
}

model PersonnelCodeSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model PersonnelMember {
  id                       String          @id @default(cuid())
  institutionalCode        String          @unique
  codeYear                 Int
  codeSequence             Int
  personnelType            PersonnelType
  status                   PersonnelStatus @default(ACTIVE)
  admissionDate            DateTime
  rankId                   String
  departmentId             String?
  positionId               String?
  historicalHours          Decimal         @default(0) @db.Decimal(10, 2)
  firstNames               String
  lastNames                String
  documentType             DocumentType
  documentNumber           String?
  documentNumberNormalized String?         @unique
  birthDate                DateTime?
  sex                      Sex?
  maritalStatus            MaritalStatus?
  nationality              String          @default("Dominicana")
  birthplace               String?
  heightCm                 Decimal?        @db.Decimal(5, 2)
  phone                    String?
  email                    String?
  address                  String?
  province                 String?
  municipality             String?
  neighborhood             String?
  worksCurrently           Boolean         @default(false)
  workplace                String?
  occupation               String?
  workAddress              String?
  workPhone                String?
  hasDriverLicense         Boolean         @default(false)
  driverLicenseCategory    String?
  driverLicenseExpiresAt   DateTime?
  bloodType                BloodType?
  healthCondition          String?
  hasAllergies             Boolean         @default(false)
  allergies                String[]        @default([])
  emergencyContactName     String?
  emergencyRelationship    String?
  emergencyPhone           String?
  educationLevel           EducationLevel?
  educationalInstitution   String?
  degreeObtained           String?
  languages                String[]        @default([])
  technicalCourses         String[]        @default([])
  recommendedByMemberId    String?
  applicationDate          DateTime?
  observations             String?         @db.Text
  photoData                Bytes?
  photoMimeType            String?
  createdByUserId          String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  rank            Rank             @relation(fields: [rankId], references: [id], onDelete: Restrict)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position        Position?        @relation(fields: [positionId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("PersonnelMemberCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  recommender     PersonnelMember? @relation("PersonnelRecommendations", fields: [recommendedByMemberId], references: [id], onDelete: SetNull)
  recommendations PersonnelMember[] @relation("PersonnelRecommendations")
  typeHistory     PersonnelTypeHistory[]
  rankHistory     PersonnelRankHistory[]
  assignmentHistory PersonnelAssignmentHistory[]
  statusHistory     PersonnelStatusHistory[]

  @@unique([codeYear, codeSequence])
  @@index([status, lastNames, firstNames])
  @@index([personnelType])
  @@index([rankId])
  @@index([departmentId])
  @@index([positionId])
  @@index([recommendedByMemberId])
  @@index([createdByUserId])
}

model PersonnelTypeHistory {
  id            String        @id @default(cuid())
  memberId      String
  personnelType PersonnelType
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?       @db.Text
  createdAt     DateTime      @default(now())

  member PersonnelMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, effectiveFrom])
}

model PersonnelRankHistory {
  id            String   @id @default(cuid())
  memberId      String
  rankId        String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  member PersonnelMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rank   Rank            @relation(fields: [rankId], references: [id], onDelete: Restrict)

  @@index([memberId, effectiveFrom])
  @@index([rankId])
}

model PersonnelAssignmentHistory {
  id            String   @id @default(cuid())
  memberId      String
  departmentId  String?
  positionId    String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  member     PersonnelMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  department Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position   Position?       @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([memberId, effectiveFrom])
  @@index([departmentId])
  @@index([positionId])
}


model PersonnelStatusHistory {
  id            String          @id @default(cuid())
  memberId      String
  status        PersonnelStatus
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?         @db.Text
  createdAt     DateTime        @default(now())

  member PersonnelMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, effectiveFrom])
  @@index([status])
}
